# ----------------------------------------------------------------------------
# Patient / clinical data — NEVER commit.
# Excludes the bundled sample trichology photos, every loose photo in the
# project root, the original Colab notebook with sample imagery, and any
# HEIC/RAW conversions that may be dropped in the working tree.
# ----------------------------------------------------------------------------

data/

# Loose medical images in the project root (l1.JPG, d1.JPG, 11-07-2026.JPG, …)
*.JPG
*.jpg
*.JPEG
*.jpeg
*.PNG
*.png
*.HEIC
*.heic
*.HEIF
*.heif
*.WEBP
*.webp
*.TIFF
*.tiff
*.tif

# Original Colab notebook (contains sample imagery + history).
*.ipynb

# Any temporary uploads directory the FastAPI process might leave behind.
athenas_uploads/

# Any private env file with patient IDs / API keys.
.env
.env.local
.env.*.local

# CSV / Excel with patient tables — kept here so accidental exports don't leak.
*.csv
*.xlsx
*.xls